% This is a style file for "color universal design".
% This is based on
% CUD color set designed by CUDO [1].
% See also [2].
% [1] https://cudo.jp
% [2] http://jfly.iam.u-tokyo.ac.jp/colorset/
%
%
% This style file is written  by NUmata yacehide.


% Defined colors:
% cud-a1 ... cud-a9 : accent colors (to use text).
% cud-b1 ... cud-b7 : base colors (to use back ground).
% cud-g1 .. cud-g4 : gray scale colors.
%
% cud-b1a ... cud-b7a : 
%     white!50!cud-b1a = cud-b1 etc.
%     Some of them are not defied in some color model.
% 
%
% cud-red : accent color (a1)
% cud-yellow : accent color (a2)
% cud-green : accent color (a3)
% cud-blue : accent color (a4)
% cud-cyan : accent color (a5)
% cud-pink : accent color (a6)
% cud-orange : accent color (a7)
% cud-violet : accent color (a8)
% cud-brown : accent color (a9)
%
% cud-lightpink : base color (b1)
% cud-cream : base color (b2)
% cud-lightchartreuse : base color (b3)
% cud-lightblue : base color (b4)
% cud-beige : base color (b5)
% cud-lightgreen : base color (b6)
% cud-lightviolet : base color (b7)
%
% cud-white : gray scale color (g1)
% cud-lightgray : gray scale color (g2)
% cud-gray : gray scale color (g3)
% cud-black : gray scale color (g4)



% Options:
% v1 : CUD color set version 1. This is the same as v2.
% v2 : CUD color set version 2.
% v3 : CUD color set version 3.
% v4 : CUD color set version 4. Defualt.
% cmyk : define colors with cmyk model.  Default. 
% RGB :  define colors with RGB model.

% Remarks:
% The color definitions in RGB and cmyk models of this style file
% are the same ones defined in the document of CUDO.
%
% The formulae to translate RGB to cmyk
% are different between xcolor and the document of CUDO.
%
% The document of version 1 of CUDO does not include
% the color definitions in RGB and cmyk models.
% The color set of version 1, however,
% is the same as one of version 2,
% which has the definition in RGB and cmyk models.

\RequirePackage{xcolor}

\newif\if@nu@cud@cmyk@
\newif\if@nu@cud@RGB@
\newif\if@nu@cud@jpma@

\@nu@cud@cmyk@false
\@nu@cud@RGB@false
\@nu@cud@jpma@false

\newif\if@nu@cud@v@i@
\newif\if@nu@cud@v@ii@
\newif\if@nu@cud@v@iii@
\newif\if@nu@cud@v@iv@

\@nu@cud@v@iv@false
\@nu@cud@v@iii@false
\@nu@cud@v@ii@false

\newif\if@nu@cud@overwrite@
\@nu@cud@overwrite@false

\DeclareOption{cmyk}{\@nu@cud@cmyk@true}
\DeclareOption{RGB}{\@nu@cud@RGB@true}
\DeclareOption{jpma}{\@nu@cud@jpma@true}
\DeclareOption{v1}{\@nu@cud@v@ii@true}
\DeclareOption{v2}{\@nu@cud@v@ii@true}
\DeclareOption{v3}{\@nu@cud@v@iii@true}
\DeclareOption{v4}{\@nu@cud@v@iv@true}
\DeclareOption{overwrite}{\@nu@cud@overwrite@true}
\ProcessOptions\relax


\if@nu@cud@cmyk@
\@nu@cud@jpma@false
\@nu@cud@RGB@false
\else
\fi



